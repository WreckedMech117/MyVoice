# ===========================================================================
# Audio files
# ===========================================================================
# Test outputs / runtime cache at root and elsewhere — but the bundled voice
# library at voice_files/ is part of the project and IS tracked.
*.wav
*.mp3
*.flac
!voice_files/**/*.wav
!voice_files/**/*.mp3
!voice_files/**/*.flac

# Story 17.2 lazy voice_clone_prompt precompute artifacts (per-voice runtime
# caches at voice_files/<name>.quality.pt + .quality.pt.meta.json). Created
# on first generation; not source data.
voice_files/*.quality.pt
voice_files/*.quality.pt.meta.json

# build_release.bat answer-piping leftover (auto-increment Y/N response).
build_increment_answer.txt

# ===========================================================================
# Models (downloadable — not committed; users install separately)
# Anchored to repo root so tests/unit/models/ is not accidentally ignored.
# ===========================================================================
/models/
/whisper_models/

# ===========================================================================
# Vendored binaries
# ===========================================================================
ffmpeg/

# ===========================================================================
# Local-only working directories
# ===========================================================================
backup/

# ===========================================================================
# AI-assisted development workflow (internal — see DEVELOPER.md)
# ===========================================================================
# The BMAD framework is vendored locally during development but is installed
# separately if forking. Internal planning + retrospective artifacts under
# _bmad-output/ are kept out of the public repo to keep the release surface
# focused on the functioning program.
_bmad/
_bmad-output/

